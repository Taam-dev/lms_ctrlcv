# -----------------------------------------------------------------------------
# 1. Môi trường & Khóa bí mật (Environment & Secret Keys)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.env.backup
.env.production
.env.local
.env.testing
/auth.json

# Khóa bảo mật & Chứng chỉ SSL/TLS
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
id_rsa*
id_ed25519*
/storage/*.key
/storage/oauth-*.key
/storage/oauth-*.pub

# -----------------------------------------------------------------------------
# 2. Cơ sở dữ liệu & Tệp sao lưu (Database & Dumps)
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.sql
*.sql.gz
*.dump
/database/*.sqlite*
/database/*.db
/database/*.sql

# -----------------------------------------------------------------------------
# 3. Laravel Storage & Logs (Bộ nhớ đệm, Phiên làm việc & Tải lên)
# -----------------------------------------------------------------------------
*.log
/storage/logs/*
!/storage/logs/.gitignore
/storage/pail

# Framework cache, views, sessions
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore

# Tệp tin người dùng tải lên (User uploads & private storage)
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/.gitignore
!/storage/app/private/.gitignore
/public/storage

# -----------------------------------------------------------------------------
# 4. Gói phụ thuộc & Tệp build Frontend (Dependencies & Build Artifacts)
# -----------------------------------------------------------------------------
/vendor
/node_modules
/public/build
/public/hot
/public/fonts-manifest.dev.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# 5. Công cụ phát triển & Trình biên soạn (IDEs, Editors & AI Assistants)
# -----------------------------------------------------------------------------
/.idea
/.vscode
/.cursor/
/.nova
/.zed
/.codex
/.gemini/
/.agents/
/.claude/
.antigravity*
*.sublime-project
*.sublime-workspace
.phpactor.json
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
.phpunit.result.cache
/.phpunit.cache

# -----------------------------------------------------------------------------
# 6. Tệp tạm của Hệ điều hành (Operating System Files)
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
Desktop.ini

# -----------------------------------------------------------------------------
# 7. Môi trường máy chủ ảo (Homestead / Vagrant)
# -----------------------------------------------------------------------------
Homestead.json
Homestead.yaml
/.vagrant
