APP_NAME="Ctrl C+V"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ctrlcv.io.vn
FORCE_HTTPS=true
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# cấu hình database
DB_CONNECTION=mysql
# railway mysql tự sinh biến host port db user password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms-mini
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ctrlcv.io.vn"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# cấu hình google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Cấu hình Multi-API Key & Multi-Provider AI (Hỗ trợ xoay vòng và tự động Failover)
AI_CHAT_ENABLED=true
AI_PROVIDER_1_URL=
AI_PROVIDER_1_KEY=
AI_PROVIDER_1_MODEL=gpt-4o-mini
AI_PROVIDER_2_URL=
AI_PROVIDER_2_KEY=
AI_PROVIDER_2_MODEL=gemini-2.0-flash
AI_PROVIDER_3_URL=
AI_PROVIDER_3_KEY=
AI_PROVIDER_3_MODEL=llama-3.3-70b-versatile
AI_API_KEYS=

# Cấu hình Local AI Chatbot (Ollama, LM Studio làm tầng backup)
LOCAL_AI_ENABLED=true
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=qwen2.5:latest
LOCAL_AI_API_KEY=
LOCAL_AI_TIMEOUT=30
LOCAL_AI_CONNECT_TIMEOUT=3


