APP_NAME="Ctrl C+V"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ctrlcv.io.vn
FORCE_HTTPS=true
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# cấu hình database
DB_CONNECTION=mysql
# railway mysql tự sinh biến host port db user password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms-mini
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ctrlcv.io.vn"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# cấu hình google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Cấu hình Multi-Provider AI (Tự động theo dõi model mới nhất đang hoạt động & Chuyển đổi API backup khi hết token)
AI_CHAT_ENABLED=true
AI_AUTO_TRACK_MODELS=true
AI_FAILOVER_COOLDOWN=300

# Provider 1 (Chính - Primary)
AI_PROVIDER_1_NAME="Provider 1 (Chính)"
AI_PROVIDER_1_URL=
AI_PROVIDER_1_KEY=
AI_PROVIDER_1_MODEL=auto

# Provider 2 (Backup 1 - Dự phòng khi hết token/quota)
AI_PROVIDER_2_NAME="Provider 2 (Backup)"
AI_PROVIDER_2_URL=
AI_PROVIDER_2_KEY=
AI_PROVIDER_2_MODEL=auto

# Provider 3 (Backup 2)
AI_PROVIDER_3_NAME="Provider 3 (Backup)"
AI_PROVIDER_3_URL=
AI_PROVIDER_3_KEY=
AI_PROVIDER_3_MODEL=auto

# Danh sách API Keys phụ trợ (nếu dùng chung 1 URL)
AI_API_URL=
AI_API_KEYS=
AI_API_MODEL=auto

# Cài đặt kết nối chung
AI_TIMEOUT=30
AI_CONNECT_TIMEOUT=5
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=1200
AI_MAX_HISTORY_TURNS=8



